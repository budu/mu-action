#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints the CHANGELOG.md section of a version, without its heading.
#
#   changelog-section 0.3.0
#   changelog-section Unreleased
#   changelog-section --tag-message 0.3.0   # prefixed with "Release version 0.3.0"

tag_message = ARGV.delete("--tag-message")
version = ARGV.first&.delete_prefix("v") or abort "Usage: changelog-section [--tag-message] VERSION"

root = `git rev-parse --show-toplevel`.chomp
changelog = File.read(File.join(root, "CHANGELOG.md"))
sections = changelog.split(/^## \[([^\]]+)\][^\n]*\n/).drop(1).each_slice(2).to_h
body = sections[version]&.strip

abort "No section for #{version} in CHANGELOG.md" unless body
abort "The #{version} section of CHANGELOG.md is empty" if body.empty?

puts "Release version #{version}", "" if tag_message
puts body
