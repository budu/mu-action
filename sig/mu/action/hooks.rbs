module Mu
  module Action
    module Hooks
      type kind = :before | :after | :around

      STORE: Symbol

      def self.install: (untyped base) -> void
      def self.run: (untyped action) { () -> untyped } -> Success
      def self.of: (untyped action_class, kind kind) -> ::Array[untyped]
      def self.register: (untyped action_class, kind kind, ::Array[untyped] method_names, ::Proc? block) -> nil
      def self.positional_arity: (::Array[untyped] parameters) -> Integer
      def self.own: (untyped action_class, kind kind) -> ::Array[untyped]
      def self.checked_block: (kind kind, ::Array[untyped] method_names, ::Proc block) -> ::Proc
      def self.hook_names: (kind kind, ::Array[untyped] method_names) -> ::Array[Symbol]
      def self.run_hook: (untyped action, ::Proc | ::Symbol hook) -> untyped
      def self.around_chain: (untyped action) { () -> untyped } -> ::Proc
      def self.around_link: (untyped action, ::Proc | ::Symbol hook, ::Proc previous) -> ::Proc
      def self.call_around_method: (untyped action, ::Symbol hook, ::Proc previous) -> untyped
      def self.around_arguments: (untyped action, ::Array[untyped] parameters, ::Proc previous) -> ::Array[untyped]
      def self.around_method: (untyped action, Symbol method_name) -> UnboundMethod

      module ClassMethods
        def before: (*Symbol | String) ?{ (*untyped) -> untyped } -> nil
        def after: (*Symbol | String) ?{ (*untyped) -> untyped } -> nil
        def around: (*Symbol | String) ?{ (*untyped) -> untyped } -> nil
        def before_hooks: () -> ::Array[untyped]
        def after_hooks: () -> ::Array[untyped]
        def around_hooks: () -> ::Array[untyped]
      end
    end
  end
end
