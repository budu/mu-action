module Mu
  module Action
    type failure_handler = :raise | ^(untyped action, untyped error, ::Hash[Symbol, untyped] details) -> untyped

    module Configuration : Kernel
      @on_undeclared_failure: failure_handler

      def on_undeclared_failure: () -> failure_handler
      def on_undeclared_failure=: (failure_handler handler) -> failure_handler
    end
  end
end
