module Mu
  module Action : Object, Hooks
    VERSION: ::String

    CONTEXT_KEY: Symbol

    type props_recording = bool | ::Hash[Symbol, ::Array[Symbol]]

    extend Configuration
    attr_reader meta: ::Hash[untyped, untyped]
    attr_reader context: untyped

    interface _ActionInstance
      def meta: () -> ::Hash[untyped, untyped]
      def context: () -> untyped
      def class: () -> _ActionClass
      def run: () -> ::Mu::Action::Result
      def run!: () -> ::Mu::Action::Result
    end

    interface _ActionClass
      def literal_properties: () -> ::Array[untyped]
      def before_hooks: () -> ::Array[untyped]
      def after_hooks: () -> ::Array[untyped]
      def around_hooks: () -> ::Array[untyped]
      def declares_failures?: () -> bool
      def failures: () -> ::Hash[untyped, ::Hash[Symbol, untyped]]
      def failure_sources: () -> ::Array[_ActionClass]
      def props_recording: () -> props_recording
      def const_get: (Symbol) -> ::Class
      def instance_method: (Symbol) -> UnboundMethod
      def new: (*untyped, **untyped) -> _ActionInstance
    end

    def self.included: (untyped base) -> void

    module MetaPropAdder
      include Literal::Properties

      def new: (*untyped, **untyped) -> untyped
      def inherited: (untyped subclass) -> void
    end

    module HookPropagator
      def inherited: (untyped subclass) -> void
      def own_failures: () -> ::Hash[untyped, ::Hash[Symbol, untyped]]
      def failure_sources: () -> ::Array[_ActionClass]
      def props_recording: () -> props_recording
    end

    module Initializer : _ActionInstance
      @meta: ::Hash[untyped, untyped]

      def initialize: (*untyped, **untyped) -> void
      def initialize_meta: () -> void
      def recorded_props: () -> ::Hash[Symbol, untyped]?
    end

    module FailureChecking : _ActionInstance
      def failure_from: (FailureError exception) -> Failure
      def check_failure: (untyped error, ::Hash[Symbol, untyped] details, ?origin: untyped) -> void
      def failure_problem: (untyped error, ::Hash[Symbol, untyped] details) -> ::String?
      def detail_problem: (untyped error, ::Hash[Symbol, untyped] types, ::Hash[Symbol, untyped] details) -> ::String?
    end

    module ClassMethods
      include Literal::Properties

      def call: (*untyped, **untyped) -> untyped
      def call!: (*untyped, **untyped) -> untyped
      def result: (untyped type) -> ::Class
      def failure: (*untyped codes, ?from: untyped, **untyped details) -> ::Array[_ActionClass]
      def failures: () -> ::Hash[untyped, ::Hash[Symbol, untyped]]
      def declares_failures?: () -> bool
      def own_failures: () -> ::Hash[untyped, ::Hash[Symbol, untyped]]
      def failure_sources: () -> ::Array[_ActionClass]
      def record_props: (?bool enabled, ?only: (Symbol | ::Array[Symbol])?, ?except: (Symbol | ::Array[Symbol])?) -> props_recording
      def props_recording: () -> props_recording
      def build_props_recording: (bool enabled, (Symbol | ::Array[Symbol])? only, (Symbol | ::Array[Symbol])? except) -> props_recording
      def const_set: (Symbol, ::Class) -> ::Class
      def new: (*untyped, **untyped) -> _ActionInstance
    end

    def Success: (?untyped value) -> Success
    def Failure: (untyped error, **untyped) -> bot
    def run: () -> Result
    def run!: () -> Result
    def with_context: [T] () { () -> T } -> T
    def failure_from: (FailureError exception) -> Failure
    def check_failure: (untyped error, ::Hash[Symbol, untyped] details, ?origin: untyped) -> void
    def call: () -> untyped
  end
end
