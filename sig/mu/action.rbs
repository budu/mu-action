module Mu
  module Action : Object
    VERSION: ::String

    type failure_handler = :raise | ^(untyped action, untyped error, ::Hash[Symbol, untyped] details) -> untyped

    self.@on_undeclared_failure: failure_handler

    def self.on_undeclared_failure: () -> failure_handler
    def self.on_undeclared_failure=: (failure_handler handler) -> failure_handler
    def self.included: (untyped base) -> void
    def self.own_result: (untyped action, untyped value, ::String source) -> Success

    module ClassMethods
      include Literal::Properties

      RESERVED_PROPS: ::Array[Symbol]

      def literal_properties: () -> ::Array[untyped]
      def call: (*untyped, **untyped) -> untyped
      def call!: (*untyped, **untyped) -> untyped
      def result: (untyped type) -> ::Class
      def const_set: (Symbol, ::Class) -> ::Class
      def new: (*untyped, **untyped) -> untyped
    end

    @meta: ::Hash[untyped, untyped]
    @context: untyped

    def meta: () -> ::Hash[untyped, untyped]
    def context: () -> untyped
    def Success: (?untyped value) -> Success
    def Failure: (untyped error, **untyped) -> bot
    def run: () -> Result
    def run!: () -> Result
    def call: () -> untyped
    def initialize_meta: () -> void
  end
end
