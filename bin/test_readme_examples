#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "mu/action"
require "optparse"

# Runs the Ruby code blocks of the README, so that the documentation cannot drift
# from the code. Each block runs at the top level, where its README line numbers
# are kept, so that a failure points at the README.
#
#   bin/test_readme_examples                  run every block
#   bin/test_readme_examples --extract-only   write them to readme_examples.rb instead
#
# bin/console loads this file to make the classes of the examples available.
class ReadmeExamples
  include Mu::Action

  # A code block, with its file and the line of its first line of code.
  Block = Struct.new(:path, :line, :code) do
    def classes = code.scan(/^class (\w+)/).flatten.map(&:to_sym)

    # The line an error comes from: the one in its backtrace, or the one a
    # syntax error names in its message.
    def line_of(error)
      error.backtrace_locations&.find { _1.path == path }&.lineno ||
        error.message[/#{Regexp.escape(path)}:(\d+)/, 1]&.to_i || line
    end

    # The code with its line numbers in the file, and an arrow on one line.
    def listing(marked)
      code.lines.each.with_index(line).map do |text, number|
        format("%<mark>s %<number>4d | %<text>s", mark: number == marked ? "→" : " ", number:, text:)
      end.join
    end
  end

  # What the examples refer to without defining it: the assert they use, and
  # stand-ins for the application classes they mention.
  SUPPORT = <<~RUBY
    def assert(condition) = condition || raise("Assertion failed")

    User = Struct.new(:email, :name, :age) do
      def self.exists?(email:) = email == "existing@example.com"
      def self.create!(email:, name:, age:) = new(email, name, age)
    end

    module Rails
      def self.logger = @logger ||= Class.new { def info(_message) = nil }.new
    end

    module ActiveRecord
      class Base
        def self.transaction = yield
      end
    end
  RUBY

  failure :no_examples, path: String
  failure :example_failed, block: Block, error: Exception

  prop :readme, String, default: "README.md"
  prop :extract_to, _Nilable(String)

  def call
    blocks = extract_blocks
    Failure(:no_examples, path: @readme) if blocks.empty?

    @extract_to ? write(blocks) : run_blocks(blocks)
    Success(blocks: blocks.size, classes: blocks.flat_map(&:classes).uniq)
  end

  # Prints the block of a failed example, with an arrow on the line that failed.
  def self.report(block, error)
    failed = block.line_of(error)
    puts "❌ #{block.path}:#{failed}: #{error.class}: #{error.message.lines.first&.strip}", "", block.listing(failed)
  end

  private

  def extract_blocks
    blocks = []
    current = nil
    File.foreach(@readme).with_index(1) do |line, number|
      case line.strip
      when "```ruby" then current = Block.new(@readme, number + 1, +"")
      when "```" then current = finish(current, blocks)
      else current.code << code_line(line) if current
      end
    end
    blocks
  end

  # A Gemfile line is not an example. It is blanked and not dropped, to keep
  # the line numbers of the block.
  def code_line(line) = line.strip.start_with?("gem ") ? "\n" : line

  def finish(block, blocks)
    blocks << block if block && !block.code.strip.empty?
    nil
  end

  def run_blocks(blocks)
    TOPLEVEL_BINDING.eval(SUPPORT, __FILE__)
    defined = []
    blocks.each do |block|
      # The README defines some classes twice, to show two ways of writing
      # them. Each definition starts from a new class, not from the previous one.
      (block.classes & defined).each { Object.send(:remove_const, _1) }
      defined.concat(block.classes)
      run_block(block)
    end
  end

  def run_block(block)
    TOPLEVEL_BINDING.eval(block.code, block.path, block.line)
  rescue StandardError, ScriptError => e
    Failure(:example_failed, block:, error: e)
  end

  def write(blocks)
    header = "# frozen_string_literal: true\n\nrequire \"mu/action\"\n"
    sections = blocks.map { "# #{_1.path}:#{_1.line}\n#{_1.code}" }
    File.write(@extract_to, [header, SUPPORT, *sections].join("\n"))
  end
end

if __FILE__ == $PROGRAM_NAME
  options = {}
  output = "readme_examples.rb"
  OptionParser.new do |parser|
    parser.banner = "Usage: #{$PROGRAM_NAME} [options]"
    parser.on("-r", "--readme FILE", "README to read (default: README.md)") { options[:readme] = _1 }
    parser.on("-o", "--output FILE", "File written by --extract-only (default: #{output})") { output = _1 }
    parser.on("--extract-only", "Write the examples to a file without running them") { options[:extract_to] = true }
  end.parse!
  options[:extract_to] &&= output

  case ReadmeExamples.call(**options)
  in Mu::Action::Success(value: { blocks: }) if options[:extract_to]
    puts "✅ Extracted #{blocks} Ruby code blocks to #{options[:extract_to]}"
  in Mu::Action::Success(value: { blocks: })
    puts "✅ Successfully tested #{blocks} Ruby code blocks"
  in Mu::Action::Failure(error: :no_examples, details: { path: })
    abort "❌ No Ruby code block in #{path}"
  in Mu::Action::Failure(error: :example_failed, details: { block:, error: })
    ReadmeExamples.report(block, error)
    exit 1
  end
end
